      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"commerce\"}[5m])))", "refId": "A" }],
      "title": "HTTP P95 延迟",
      "type": "stat"
    },
